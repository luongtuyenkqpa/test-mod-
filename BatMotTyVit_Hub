local function updateEsp()
    -- Quét lại mỗi 1.5s
    State.ScanTick = State.ScanTick + 1
    if State.ScanTick % 90 == 0 then
        local found = scanDucks()
        -- Xóa vịt không còn
        for duck in pairs(State.Ducks) do
            if not found[duck] or not duck.Parent then
                removeEsp(duck)
            end
        end
        -- Thêm vịt mới
        for duck in pairs(found) do
            if Config.ESP_Enabled then createEsp(duck) end
        end
    end

    -- Cập nhật label + tracer
    local myChar = LocalPlayer.Character
    local myRoot = myChar and safe(function() return myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart") end)
    local cam = workspace.CurrentCamera

    for duck, data in pairs(State.Ducks) do
        if not duck.Parent or not getRootPart(duck) then
            removeEsp(duck)
        else
            local root = data.root
            -- Bật/tắt theo config
            if data.highlight then data.highlight.Enabled = Config.ESP_Enabled and Config.ESP_UseHighlight end
            if data.billboard then data.billboard.Enabled = Config.ESP_Enabled and (Config.ESP_Name or Config.ESP_Distance) end
            if not Config.ESP_Enabled then
                if data.tracer then data.tracer.Visible = false end
            else
                local pos = root.Position
                local dist = myRoot and (myRoot.Position - pos).Magnitude or 0
                if dist > Config.ESP_MaxDistance then
                    if data.billboard then data.billboard.Enabled = false end
                    if data.highlight then data.highlight.Enabled = false end
                    if data.tracer then data.tracer.Visible = false end
                else
                    if data.distLbl then
                        data.distLbl.Text = Config.ESP_Distance and string.format("%.0f studs", dist) or ""
                    end
                    if data.nameLbl then
                        data.nameLbl.Text = Config.ESP_Name and "🦆 VỊT" or ""
                    end
                    -- Tracer
                    if Config.ESP_Tracer and data.tracer and cam then
                        local vec, onScreen = cam:WorldToViewportPoint(pos)
                        if onScreen then
                            data.tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                            data.tracer.To = Vector2.new(vec.X, vec.Y)
                            data.tracer.Visible = true
                            data.tracer.Color = Config.ESP_Color
                        else
                            data.tracer.Visible = false
                        end
                    elseif data.tracer then
                        data.tracer.Visible = false
                    end
                end
            end
        end
    end
end

--// ============================================================
--//  AIMBOT — tìm vịt gần crosshair nhất trong FOV
--// ============================================================
local function findBestTarget()
    local cam = workspace.CurrentCamera
    local mouseCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best, bestDist = nil, Config.Aim_FOV

    for duck in pairs(State.Ducks) do
        if duck.Parent then
            local pos = getTargetPosition(duck)
            if pos then
                local vec, onScreen = cam:WorldToViewportPoint(pos)
                if onScreen and vec.Z > 0 then
                    local d = (Vector2.new(vec.X, vec.Y) - mouseCenter).Magnitude
                    if d < bestDist then
                        -- Kiểm tra khoảng cách 3D
                        local myChar = LocalPlayer.Character
                        local myRoot = myChar and safe(function() return myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart") end)
                        local dist3d = myRoot and (myRoot.Position - pos).Magnitude or 0
                        if dist3d <= Config.AutoKill_Range then
                            best, bestDist = duck, d
                        end
                    end
                end
            end
        end
    end
    return best
end

local function aimAt(targetPos, smooth)
    local cam = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myRoot = myChar and safe(function() return myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart") end)
    if not myRoot then return end
    local goal = CFrame.new(cam.CFrame.Position, targetPos)
    if smooth and smooth > 0.01 then
        cam.CFrame = cam.CFrame:Lerp(goal, 1 - smooth)
    else
        cam.CFrame = goal
    end
end

