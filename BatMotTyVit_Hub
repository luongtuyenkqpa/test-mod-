    lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left
    local tg = Instance.new("TextButton", row)
    tg.Size=UDim2.new(0,36,0,18); tg.Position=UDim2.new(1,-44,0.5,-9)
    tg.BackgroundColor3 = Config[key] and accent or Color3.fromRGB(70,70,80)
    tg.Text=""; tg.AutoButtonColor=false
    Instance.new("UICorner", tg).CornerRadius=UDim.new(1,0)
    local knob = Instance.new("Frame", tg)
    knob.Size=UDim2.new(0,14,0,14); knob.BorderSizePixel=0
    knob.Position = Config[key] and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)
    knob.BackgroundColor3=Color3.new(1,1,1)
    Instance.new("UICorner", knob).CornerRadius=UDim.new(1,0)
    tg.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        TweenService:Create(tg, TweenInfo.new(0.15), {BackgroundColor3=Config[key] and accent or Color3.fromRGB(70,70,80)}):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {Position=Config[key] and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)}):Play()
        if cb then cb(Config[key]) end
    end)
    table.insert(TabContents[tab], row)
    return row
end

local function makeSlider(text, key, mn, mx, suf, tab, cb)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -8, 1, -4)
    row.Position = UDim2.new(0, 4, 0, 2)
    row.BackgroundColor3 = CARD
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)
    local lbl = Instance.new("TextLabel", row)
    lbl.Size=UDim2.new(1,-10,0,14); lbl.Position=UDim2.new(0,8,0,3)
    lbl.BackgroundTransparency=1; lbl.Text=text; lbl.TextColor3=TEXT; lbl.TextSize=10.5
    lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left
    local vl = Instance.new("TextLabel", row)
    vl.Size=UDim2.new(0,60,0,14); vl.Position=UDim2.new(1,-66,0,3)
    vl.BackgroundTransparency=1; vl.Text=string.format("%.2f%s", Config[key], suf or ""); vl.TextColor3=accent
    vl.TextSize=10.5; vl.Font=Enum.Font.GothamBold; vl.TextXAlignment=Enum.TextXAlignment.Right
    local barBg = Instance.new("Frame", row)
    barBg.Size=UDim2.new(1,-16,0,5); barBg.Position=UDim2.new(0,8,1,-9)
    barBg.BackgroundColor3=Color3.fromRGB(55,55,65); barBg.BorderSizePixel=0
    Instance.new("UICorner", barBg).CornerRadius=UDim.new(1,0)
    local fill = Instance.new("Frame", barBg)
    local pct = (Config[key]-mn)/(mx-mn); fill.Size=UDim2.new(pct,0,1,0)
    fill.BackgroundColor3=accent; fill.BorderSizePixel=0
    Instance.new("UICorner", fill).CornerRadius=UDim.new(1,0)
    local btn = Instance.new("TextButton", barBg)
    btn.Size=UDim2.new(1,0,1,0); btn.Position=UDim2.new(0,0,0,-6); btn.BackgroundTransparency=1; btn.Text=""
    local drag=false
    local function upd(i)
        local rel=(i.Position.X - barBg.AbsolutePosition.X)/barBg.AbsoluteSize.X
        rel=math.clamp(rel,0,1); local v=mn+rel*(mx-mn); Config[key]=v
        fill.Size=UDim2.new(rel,0,1,0); vl.Text=string.format("%.2f%s",v,suf or "")
        if cb then cb(v) end
    end
    btn.MouseButton1Down:Connect(function() drag=true end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end)
    UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i) end end)
    table.insert(TabContents[tab], row)
    return row
end

