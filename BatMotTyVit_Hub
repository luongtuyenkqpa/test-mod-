local DUCK_NAME_PATTERNS = {
    "duck", "vit", "vịt", "bird", "mallard", "goose", "ngỗng", "ngong",
    "duckling", "convit", "con_vit", "target", "mob", "npc", "animal",
    "enemy", "flying", "bay", "chicken", "ga", "gà", "pigeon", "bồ câu",
    "seagull", "hawk", "eagle", "crow", "sparrow",
}
local DUCK_FOLDER_PATTERNS = {
    "duck", "vit", "vịt", "bird", "npc", "mob", "animal", "entity",
    "target", "enemy", "wildlife", "spawn", "flying",
}
local BLACKLIST_PATTERNS = {
    "player", "local", "camera", "terrain", "baseplate", "map", "world",
    "weapon", "tool", "gun", "sung", "bullet", "projectile", "effect",
    "particle", "debris", "sound", "gui", "menu",
}

local function nameMatches(name, patterns)
    local low = string.lower(tostring(name or ""))
    for _, p in ipairs(patterns) do
        if string.find(low, string.lower(p), 1, true) then return true end
    end
    return false
end

local function isBlacklisted(name)
    return nameMatches(name, BLACKLIST_PATTERNS)
end

local function isPlayerCharacter(model)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return true end
    end
    return false
end

local function looksLikeDuck(model)
    if not model or not model:IsA("Model") then return false end
    if isPlayerCharacter(model) then return false end
    local name = model.Name
    if isBlacklisted(name) then return false end
    -- Có Humanoid (NPC) → gần như chắc chắn là mob/vịt
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        -- Loại trừ player character (đã check ở trên)
        return true
    end
    -- Tên trùng pattern vịt
    if nameMatches(name, DUCK_NAME_PATTERNS) then
        return true
    end
    -- Nằm trong folder có tên vịt/mob
    local parent = model.Parent
    while parent and parent ~= workspace do
        if nameMatches(parent.Name, DUCK_FOLDER_PATTERNS) and not isBlacklisted(parent.Name) then
            return true
        end
        parent = parent.Parent
    end
    return false
end

local function scanDucks()
    local found = {}
    local function check(obj)
        if looksLikeDuck(obj) and getRootPart(obj) then
            found[obj] = true
        end
    end
    -- Quét các folder con trực tiếp của workspace (nhanh)
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            check(child)
            -- Nếu là folder chứa nhiều vịt, quét tiếp con
            for _, sub in ipairs(child:GetChildren()) do
                if sub:IsA("Model") then check(sub) end
            end
        elseif child:IsA("Folder") then
            for _, sub in ipairs(child:GetChildren()) do
                if sub:IsA("Model") then check(sub) end
            end
        end
    end
    return found
end

