local function removeEsp(d)
    local t = State.Ducks[d]; if not t then return end
    safe(function() if t.hl then t.hl:Destroy() end end)
    safe(function() if t.bb then t.bb:Destroy() end end)
    safe(function() if t.tr then t.tr.Visible=false; t.tr:Remove() end end)
    State.Ducks[d] = nil
end

local function createEsp(duck)
    if State.Ducks[duck] then return end
    local root = getRootPart(duck); if not root then return end
    local hl
    if Config.ESP_UseHighlight then
        hl = Instance.new("Highlight")
        hl.FillColor = Config.ESP_Color; hl.FillTransparency = 0.55
        hl.OutlineColor = Config.ESP_Color; hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = duck; hl.Parent = EspFolder
    end
    local bb = Instance.new("BillboardGui")
    bb.Adornee = root; bb.Size = UDim2.new(0,130,0,38); bb.StudsOffset = Vector3.new(0,2.5,0)
    bb.AlwaysOnTop = true; bb.Parent = EspFolder
    local nl = Instance.new("TextLabel", bb)
    nl.BackgroundTransparency=1; nl.Size=UDim2.new(1,0,0.5,0)
    nl.Font=Enum.Font.GothamBold; nl.TextSize=13; nl.TextColor3=Color3.new(1,1,1)
    nl.TextStrokeTransparency=0.4; nl.Text="🦆 VỊT"
    local dl = Instance.new("TextLabel", bb)
    dl.BackgroundTransparency=1; dl.Position=UDim2.new(0,0,0.5,0); dl.Size=UDim2.new(1,0,0.5,0)
    dl.Font=Enum.Font.Gotham; dl.TextSize=11; dl.TextColor3=Config.ESP_Color; dl.TextStrokeTransparency=0.5; dl.Text=""
    local tr = nil
    if Drawing and Drawing.new then safe(function() tr=Drawing.new("Line"); tr.Visible=false; tr.Color=Config.ESP_Color; tr.Thickness=1.5; tr.Transparency=0.8 end) end
    State.Ducks[duck] = {hl=hl, bb=bb, nl=nl, dl=dl, tr=tr, root=root}
end

local function updateEsp()
    State.ScanTick = State.ScanTick + 1
    if State.ScanTick % 90 == 0 then
        local found = scanDucks()
        for d in pairs(State.Ducks) do if not found[d] or not d.Parent then removeEsp(d) end end
        for d in pairs(found) do if Config.ESP_Enabled then createEsp(d) end end
        if State.ScanTick % 300 == 0 then scanRemotes(); scanAmmoValues() end
    end
    local cam = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myRoot = myChar and safe(function() return myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart") end)
    for duck, t in pairs(State.Ducks) do
        if duck.Parent and getRootPart(duck) then
        local on = Config.ESP_Enabled
        if t.hl then t.hl.Enabled = on and Config.ESP_UseHighlight end
        if t.bb then t.bb.Enabled = on and (Config.ESP_Name or Config.ESP_Distance) end
        if on then
        local pos = t.root.Position
        local dist = myRoot and (myRoot.Position - pos).Magnitude or 0
        if dist > Config.ESP_MaxDistance then
            if t.hl then t.hl.Enabled=false end
            if t.bb then t.bb.Enabled=false end
            if t.tr then t.tr.Visible=false end
        else
            if t.dl then t.dl.Text = Config.ESP_Distance and string.format("%.0f studs", dist) or "" end
            if t.nl then t.nl.Text = Config.ESP_Name and "🦆 VỊT" or "" end
            if Config.ESP_Tracer and t.tr and cam then
                local vec, onScr = cam:WorldToViewportPoint(pos)
                if onScr then
                    t.tr.From = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
                    t.tr.To = Vector2.new(vec.X, vec.Y); t.tr.Visible=true; t.tr.Color=Config.ESP_Color
                else t.tr.Visible=false end
            elseif t.tr then t.tr.Visible=false end
        end
        end
        end
    end
end

--// ============================================================
--//  AIMBOT + FIRE
--// ============================================================
local function findBestTarget()
    local cam = workspace.CurrentCamera
    local ctr = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local best, bd = nil, Config.Aim_FOV
    local myChar = LocalPlayer.Character
    local myRoot = myChar and safe(function() return myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart") end)
    for duck in pairs(State.Ducks) do
        if duck.Parent and not isDeadOrFalling(duck) then
            local pos = getTargetPos(duck)
            if pos then
                local vec, onScr = cam:WorldToViewportPoint(pos)
                if onScr and vec.Z>0 then
                    local d = (Vector2.new(vec.X,vec.Y)-ctr).Magnitude
                    if d < bd then
                        local d3 = myRoot and (myRoot.Position-pos).Magnitude or 0
                        if d3 <= Config.AutoKill_Range then best, bd = duck, d end
                    end
                end
            end
        end
    end
    return best
end

local function aimAt(pos, smooth)
    local cam = workspace.CurrentCamera
    local goal = CFrame.new(cam.CFrame.Position, pos)
    if smooth and smooth > 0.01 then cam.CFrame = cam.CFrame:Lerp(goal, 1-smooth)
    else cam.CFrame = goal end
end

local function getTool()
    local char = LocalPlayer.Character; if not char then return nil end
    for _, c in ipairs(char:GetChildren()) do if c:IsA("Tool") then return c end end
    return nil
end

local function fireOnce(targetDuck)
    local fired = false
    local tool = getTool()
    if tool then
        safe(function() tool:Activate(); fired=true end)
        safe(function()
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("RemoteEvent") then
                    local p = getTargetPos(targetDuck)
                    pcall(function() d:FireServer(targetDuck, p) end)
                    pcall(function() d:FireServer(p) end)
                    pcall(function() d:FireServer(targetDuck) end)
                    pcall(function() d:FireServer() end)
                    fired=true
                elseif d:IsA("RemoteFunction") then
                    local p = getTargetPos(targetDuck)
                    pcall(function() d:InvokeServer(targetDuck, p) end)
                    pcall(function() d:InvokeServer(p) end)
                    pcall(function() d:InvokeServer() end)
                    fired=true
                end
            end
        end)
    end
    for _, r in ipairs(State.ShootRemotes) do
        if r and r.Parent then
            local p = getTargetPos(targetDuck)
            if r:IsA("RemoteEvent") then
                pcall(function() r:FireServer(targetDuck, p) end)
                pcall(function() r:FireServer(p) end)
                pcall(function() r:FireServer(targetDuck) end)
                pcall(function() r:FireServer() end)
                fired=true
            else
                pcall(function() r:InvokeServer(targetDuck, p) end)
                pcall(function() r:InvokeServer(p) end)
                pcall(function() r:InvokeServer() end)
                fired=true
            end
        end
    end
    return fired
end

--// Auto Kill loop
task.spawn(function()
    while true do
        task.wait(Config.AutoKill_Delay)
        if Config.AutoKill_Enabled then
            if #State.ShootRemotes==0 then scanRemotes() end
            local t = findBestTarget()
            if t then
                local pos = getTargetPos(t)
                if pos then
                    if Config.AutoKill_InstantAim then aimAt(pos, 0) else aimAt(pos, Config.Aim_Smooth) end
                    task.wait(0.02)
                    fireOnce(t)
                end
            end
        end
    end
end)

--// Rapid Fire loop (bắn liên thanh)
task.spawn(function()
    while true do
        task.wait(Config.RapidFire_Rate)
        if Config.RapidFire_Enabled then
            -- Bắn vào vịt gần nhất (nếu có aimbot/autokill thì đã aim sẵn)
            local t = findBestTarget()
            fireOnce(t)
        end
    end
end)

--// Vô hạn đạn loop — nạp đầy đạn liên tục
task.spawn(function()
    while true do
        task.wait(0.4)
        if Config.InfiniteAmmo_Enabled then
            if #State.AmmoValues == 0 then scanAmmoValues() end
            refillAmmo()
            -- Gọi luôn remote nạp đạn (reload) nếu có
            for _, r in ipairs(State.ShootRemotes) do
                if r and r.Parent and nameMatches(r.Name, {"reload","nap","nạp"}) then
                    if r:IsA("RemoteEvent") then pcall(function() r:FireServer() end)
                    else pcall(function() r:InvokeServer() end) end
                end
            end
        end
    end
end)

--// Auto Gom Vịt — hút vịt đã bắn rơi về chỗ đứng
task.spawn(function()
    while true do
        task.wait(0.15)
        if Config.AutoCollect_Enabled then
            local myChar = LocalPlayer.Character
            local myRoot = myChar and safe(function() return myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart") end)
            if myRoot then
            for duck in pairs(State.Ducks) do
                if duck.Parent and isDeadOrFalling(duck) then
                    local r = getRootPart(duck)
                    if r then
                        local dist = (r.Position - myRoot.Position).Magnitude
                        if dist < Config.AutoCollect_Radius then
                            -- Teleport vịt về ngay trên đầu người chơi để tự rơi nhặt
                            safe(function()
                                r.CFrame = CFrame.new(myRoot.Position + Vector3.new(0, 3, 0))
                                r.Velocity = Vector3.new(0, -2, 0)
                            end)
                            -- Gọi remote gom/nhặt nếu có
                            for _, cr in ipairs(State.CollectRemotes) do
                                if cr and cr.Parent then
                                    if cr:IsA("RemoteEvent") then
                                        pcall(function() cr:FireServer(duck) end)
                                        pcall(function() cr:FireServer(duck, r.Position) end)
                                        pcall(function() cr:FireServer() end)
                                    else
                                        pcall(function() cr:InvokeServer(duck) end)
                                        pcall(function() cr:InvokeServer() end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        end
    end
end)

