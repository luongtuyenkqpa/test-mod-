--//  AUTO KILL — tự động bắn toàn bộ vịt
--// ============================================================
local function getEquippedTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Tool") then return c end
    end
    return nil
end

local function scanShootRemotes()
    State.ShootRemotes = {}
    local containers = { ReplicatedStorage, workspace }
    local char = LocalPlayer.Character
    if char then table.insert(containers, char) end
    local tool = getEquippedTool()
    if tool then table.insert(containers, tool) end

    local patterns = { "shoot", "fire", "ban", "bắn", "attack", "hit", "damage",
        "kill", "catch", "bắt", "bat", "vit", "vịt", "duck", "bullet",
        "projectile", "weapon", "gun", "sung", "súng", "remote" }

    for _, cont in ipairs(containers) do
        safe(function()
            for _, d in ipairs(cont:GetDescendants()) do
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                    if nameMatches(d.Name, patterns) and not isBlacklisted(d.Name) then
                        table.insert(State.ShootRemotes, d)
                    end
                end
            end
        end)
    end
    -- Bỏ trùng
    local seen = {}
    local uniq = {}
    for _, r in ipairs(State.ShootRemotes) do
        if not seen[r] then seen[r] = true; table.insert(uniq, r) end
    end
    State.ShootRemotes = uniq
end

local function fireWeapon(targetDuck)
    local fired = false
    -- Cách 1: Kích hoạt Tool (gây sự kiện Activated cho local script của súng)
    local tool = getEquippedTool()
    if tool then
        safe(function() tool:Activate() fired = true end)
        -- Cách 2: Fire remotes trong tool
        safe(function()
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("RemoteEvent") then
                    local pos = getTargetPosition(targetDuck)
                    pcall(function() d:FireServer(targetDuck, pos) end)
                    pcall(function() d:FireServer(pos) end)
                    pcall(function() d:FireServer(targetDuck) end)
                    fired = true
                elseif d:IsA("RemoteFunction") then
                    local pos = getTargetPosition(targetDuck)
                    pcall(function() d:InvokeServer(targetDuck, pos) end)
                    pcall(function() d:InvokeServer(pos) end)
                    fired = true
                end
            end
        end)
    end
    -- Cách 3: Fire các remote đã scan
    for _, r in ipairs(State.ShootRemotes) do
        if r and r.Parent then
            local pos = getTargetPosition(targetDuck)
            if r:IsA("RemoteEvent") then
                pcall(function() r:FireServer(targetDuck, pos) end)
                pcall(function() r:FireServer(pos) end)
                pcall(function() r:FireServer(targetDuck) end)
                fired = true
            else
                pcall(function() r:InvokeServer(targetDuck, pos) end)
                pcall(function() r:InvokeServer(pos) end)
                fired = true
            end
        end
    end
    return fired
end

--// Loop auto kill (chạy nền)
task.spawn(function()
    while true do
        task.wait(Config.AutoKill_Delay)
        if Config.AutoKill_Enabled then
            -- Quét lại vịt trước khi bắn
            if #State.ShootRemotes == 0 then scanShootRemotes() end
            local target = findBestTarget()
            if target then
                State.CurrentTarget = target
                local pos = getTargetPosition(target)
                if pos then
                    if Config.AutoKill_InstantAim then
                        aimAt(pos, 0)
                    else
                        aimAt(pos, Config.Aim_Smooth)
                    end
                    task.wait(0.02)
                    fireWeapon(target)
                end
            end
        end
    end
end)

