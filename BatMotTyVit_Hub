--// ============================================================
--//  UTIL
--// ============================================================
local function safe(f, ...)
    local ok, r = pcall(f, ...)
    return ok and r or nil
end

local function getRootPart(m)
    if not m or not m.Parent then return nil end
    if m:IsA("BasePart") then return m end
    for _, n in ipairs({"HumanoidRootPart","RootPart","Torso","Head","UpperTorso","PrimaryPart"}) do
        local p = m:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    if m.PrimaryPart then return m.PrimaryPart end
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") then return p end
    end
    return nil
end

local function getDuckVelocity(m)
    local r = getRootPart(m)
    return r and (r.Velocity or r.AssemblyLinearVelocity or Vector3.zero) or Vector3.zero
end

local function getTargetPos(duck)
    local r = getRootPart(duck); if not r then return nil end
    local pos = r.Position
    local head = duck:FindFirstChild("Head")
    if head and head:IsA("BasePart") then pos = head.Position end
    if Config.Aim_Prediction > 0 then
        pos = pos + getDuckVelocity(duck) * Config.Aim_Prediction
    end
    return pos
end

local function nameMatches(name, pats)
    local low = string.lower(tostring(name or ""))
    for _, p in ipairs(pats) do
        if string.find(low, string.lower(p), 1, true) then return true end
    end
    return false
end

