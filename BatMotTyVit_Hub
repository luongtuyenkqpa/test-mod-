local SHOOT_PATS   = {"shoot","fire","ban","bắn","attack","hit","damage","kill","catch","bắt","bat","vit","vịt","duck","bullet","projectile","weapon","gun","sung","súng","shot","fireshot"}
local COLLECT_PATS = {"collect","gom","nhặt","pickup","pick","catch","bắt","bat","reward","loot","nhan","nhận","claim","gather","tele","tp","magnet","hut","hút"}
local AMMO_PATS    = {"ammo","đạn","dan","bullet","clip","reload","nap","nạp","maxammo","currentammo","ammocount","shots","dancon","đạn còn"}

local function scanRemotes()
    State.ShootRemotes, State.CollectRemotes = {}, {}
    local conts = {ReplicatedStorage, workspace}
    local char = LocalPlayer.Character; if char then table.insert(conts, char) end
    local tool = safe(function() for _, c in ipairs(char:GetChildren()) do if c:IsA("Tool") then return c end end end)
    if tool then table.insert(conts, tool) end
    for _, cont in ipairs(conts) do
        safe(function()
            for _, d in ipairs(cont:GetDescendants()) do
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                    if nameMatches(d.Name, SHOOT_PATS) and not isBlacklisted(d.Name) then
                        table.insert(State.ShootRemotes, d)
                    elseif nameMatches(d.Name, COLLECT_PATS) and not isBlacklisted(d.Name) then
                        table.insert(State.CollectRemotes, d)
                    end
                end
            end
        end)
    end
    -- bỏ trùng (clean rebuild)
    local seen = {}
    local shootUniq, collectUniq = {}, {}
    for _, r in ipairs(State.ShootRemotes) do
        if r and not seen[r] then seen[r] = true; table.insert(shootUniq, r) end
    end
    for _, r in ipairs(State.CollectRemotes) do
        if r and not seen[r] then seen[r] = true; table.insert(collectUniq, r) end
    end
    State.ShootRemotes = shootUniq
    State.CollectRemotes = collectUniq
end

-- Quét giá trị đạn (IntValue/NumberValue/Attribute)
local function scanAmmoValues()
    State.AmmoValues = {}
    local conts = {LocalPlayer, LocalPlayer:WaitForChild("leaderstats", 3)}
    local char = LocalPlayer.Character; if char then table.insert(conts, char) end
    local tool = char and safe(function() for _, c in ipairs(char:GetChildren()) do if c:IsA("Tool") then return c end end end)
    if tool then table.insert(conts, tool) end
    for _, cont in ipairs(conts) do
        if cont ~= nil then
            safe(function()
                for _, d in ipairs(cont:GetDescendants()) do
                    if (d:IsA("IntValue") or d:IsA("NumberValue")) and nameMatches(d.Name, AMMO_PATS) then
                        table.insert(State.AmmoValues, d)
                    end
                end
            end)
            -- Attributes (GetAttributes trả về dictionary → dùng pairs, không phải ipairs)
            safe(function()
                for attr, _ in pairs(cont:GetAttributes()) do
                    if nameMatches(attr, AMMO_PATS) then
                        table.insert(State.AmmoValues, {obj=cont, attr=attr})
                    end
                end
            end)
        end
    end
end

local function refillAmmo()
    for _, av in ipairs(State.AmmoValues) do
        safe(function()
            if type(av) == "table" and av.obj then
                local cur = av.obj:GetAttribute(av.attr)
                if typeof(cur) == "number" then av.obj:SetAttribute(av.attr, 9999) end
            elseif av and av.Parent then
                if av:IsA("IntValue") or av:IsA("NumberValue") then
                    av.Value = 9999
                end
            end
        end)
    end
end

