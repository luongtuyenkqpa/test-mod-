--//  PHÁT HIỆN VỊT (adaptive cho cả 2 game)
--// ============================================================
local DUCK_PATS   = {"duck","vit","vịt","bird","mallard","goose","ngỗng","ngong","duckling","convit","target","mob","npc","animal","enemy","flying","bay","chicken","ga","gà","pigeon","seagull","hawk","eagle","crow","sparrow","convit","dead","fall","rơi","loot"}
local FOLDER_PATS = {"duck","vit","vịt","bird","npc","mob","animal","entity","target","enemy","wildlife","spawn","flying","ducks","birds"}
local BLACK_PATS  = {"player","local","camera","terrain","baseplate","map","world","weapon","tool","gun","sung","súng","bullet","projectile","effect","particle","debris","sound","gui","menu","shop","cua","hang","cửa hàng","reward","phần thưởng","index","chi muc","chỉ mục","code","ma","mã"}

local function isBlacklisted(n) return nameMatches(n, BLACK_PATS) end

local function isPlayerChar(m)
    for _, p in ipairs(Players:GetPlayers()) do if p.Character == m then return true end end
    return false
end

local function looksLikeDuck(m)
    if not m or not m:IsA("Model") then return false end
    if isPlayerChar(m) then return false end
    if isBlacklisted(m.Name) then return false end
    if m:FindFirstChildOfClass("Humanoid") then return true end
    if nameMatches(m.Name, DUCK_PATS) then return true end
    local par = m.Parent
    while par and par ~= workspace do
        if nameMatches(par.Name, FOLDER_PATS) and not isBlacklisted(par.Name) then return true end
        par = par.Parent
    end
    return false
end

local function isDeadOrFalling(duck)
    -- Vịt đã bị bắn rơi: Humanoid chết / tên có dead/fall/rơi / đang rơi tự do
    local hum = duck:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    if nameMatches(duck.Name, {"dead","fall","rơi","loot","caught","bat","bắt","collected"}) then return true end
    local r = getRootPart(duck)
    if r then
        local v = r.Velocity or r.AssemblyLinearVelocity or Vector3.zero
        if v.Y < -8 and math.abs(v.X) < 30 and math.abs(v.Z) < 30 then return true end -- đang rơi thẳng
    end
    return false
end

local function scanDucks()
    local found = {}
    local function chk(o)
        if looksLikeDuck(o) and getRootPart(o) then found[o] = true end
    end
    for _, c in ipairs(workspace:GetChildren()) do
        if c:IsA("Model") then
            chk(c)
            for _, s in ipairs(c:GetChildren()) do if s:IsA("Model") then chk(s) end end
        elseif c:IsA("Folder") then
            for _, s in ipairs(c:GetChildren()) do if s:IsA("Model") then chk(s) end end
        end
    end
    return found
end

