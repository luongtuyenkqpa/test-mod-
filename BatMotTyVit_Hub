--//  RENDER LOOP — ESP + Aimbot
--// ============================================================
RunService.RenderStepped:Connect(function()
    updateEsp()

    -- Aimbot: bật khi giữ phím (hoặc toggle)
    local aimActive = Config.Aim_Enabled and (Config.Aim_Toggle and State.AimHolding or (not Config.Aim_Toggle and State.AimHolding))
    if aimActive then
        local target = findBestTarget()
        if target then
            State.CurrentTarget = target
            local pos = getTargetPosition(target)
            if pos then aimAt(pos, Config.Aim_Smooth) end
        end
    elseif not Config.AutoKill_Enabled then
        State.CurrentTarget = nil
    end
end)

