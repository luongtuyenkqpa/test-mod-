local function safe(f, ...)
    local ok, r = pcall(f, ...)
    if ok then return r end
    return nil
end

local function getRootPart(model)
    if not model or not model.Parent then return nil end
    if model:IsA("BasePart") then return model end
    local hp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("RootPart") or model:FindFirstChild("Torso")
    if hp and hp:IsA("BasePart") then return hp end
    if model.PrimaryPart then return model.PrimaryPart end
    -- fallback: part toạ độ trung tâm
    local head = model:FindFirstChild("Head")
    if head and head:IsA("BasePart") then return head end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then return p end
    end
    return nil
end

local function getDuckVelocity(model)
    local root = getRootPart(model)
    if root then
        return root.Velocity or root.AssemblyLinearVelocity or Vector3.zero
    end
    return Vector3.zero
end

local function getTargetPosition(duck)
    local root = getRootPart(duck)
    if not root then return nil end
    local pos = root.Position
    -- Ưu tiên Head nếu có
    local head = duck:FindFirstChild("Head")
    if head and head:IsA("BasePart") then pos = head.Position end
    if Config.Aim_Prediction > 0 then
        pos = pos + getDuckVelocity(duck) * Config.Aim_Prediction
    end
    return pos
end

